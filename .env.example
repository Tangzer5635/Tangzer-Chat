# Copier ce fichier en .env puis adapter les valeurs.

# Base de données PostgreSQL.
DB_USERNAME=tangzer
DB_PASSWORD=tangzer
# Port publié sur la machine, uniquement avec docker-compose.dev.yml (développement).
DB_PORT=5432

# Crée les comptes de démonstration (admin, user, tanguy, pigloo).
APP_DEMO_DATA=true

# Secret de signature des JWT (32 caractères minimum). À CHANGER.
JWT_SECRET=change-me-in-the-env-file-this-is-not-a-real-secret-0123456789

# Durée de validité d'une session (ms). 7 jours par défaut.
JWT_EXPIRATION_MS=604800000

# Origines autorisées à appeler l'API depuis un autre domaine (* = toutes).
ALLOWED_ORIGINS=*

# Ports exposés par nginx.
HTTP_PORT=80
HTTPS_PORT=443

# IP ou nom DNS du serveur à inclure dans le certificat auto-signé
# (utile pour accéder depuis un autre appareil du réseau local).
# Exemple : TLS_EXTRA_SAN=IP:192.168.1.20,DNS:tangzer.lan
TLS_EXTRA_SAN=
